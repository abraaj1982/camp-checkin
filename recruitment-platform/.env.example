# Copy to .env and fill in. Never commit the real .env (see .gitignore).

NODE_ENV=development
PORT=4000

# Local dev via infra/docker-compose.yml (host port 5433).
DATABASE_URL=postgresql://recruitment:recruitment@localhost:5433/recruitment_platform

# Any long random string in dev; a real secret manager value in staging/prod.
SESSION_SECRET=change-me-dev-only

# First concrete AI provider (architecture doc, Decision 3). Leave unset to
# run the API/worker without AI calls (routes that need it will fail fast).
ANTHROPIC_API_KEY=

# Local MinIO via infra/docker-compose.yml.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=recruitment-platform-documents
OBJECT_STORAGE_ACCESS_KEY_ID=recruitment
OBJECT_STORAGE_SECRET_ACCESS_KEY=recruitment123
