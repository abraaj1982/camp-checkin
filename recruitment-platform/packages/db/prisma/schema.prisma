// Recruitment Intelligence Platform — core schema (Phase 1 foundation).
// Evidence -> Assessment -> Decision stays traceable: assessments reference
// evidence, decisions reference assessments, overrides never edit either.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  HR_USER
  HR_ADMIN
  SYSTEM_ADMIN
}

// Project-scoped role, distinct from the system-wide UserRole. OWNER is set
// on the creator automatically; MEMBER is any HR user later assigned to
// collaborate on the project (architecture doc Phase 2: "can later support
// multiple HR users working on the same recruitment project").
enum ProjectMemberRole {
  OWNER
  MEMBER
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  READY_FOR_CV_UPLOAD
  COMPLETED
  ARCHIVED
}

enum RequirementCategory {
  EDUCATION
  PROFESSIONAL_EXPERIENCE
  FUNCTIONAL_EXPERIENCE
  TECHNICAL_SKILLS
  INDUSTRY_EXPERIENCE
  CERTIFICATIONS
  LANGUAGES
  BEHAVIORAL_COMPETENCY
  MANAGEMENT_LEADERSHIP
  LOCATION_MOBILITY
  OTHER
}

enum RequirementPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// DRAFT -> AI_ANALYZED (interpretation run) -> HR_REVIEW (weighting proposed,
// awaiting HR) -> APPROVED (weight approved, version snapshotted) -> CHANGED
// (edited after approval — see JobRequirementVersion) -> ARCHIVED.
enum RequirementStatus {
  DRAFT
  AI_ANALYZED
  HR_REVIEW
  APPROVED
  CHANGED
  ARCHIVED
}

// How closely an AI-identified concept relates to a requirement's literal
// wording (architecture doc Phase 2, Section 4) — never collapsed into a
// single "relevant/not relevant" bit.
enum SemanticRelevance {
  DIRECT
  RELEVANT
  PARTIALLY_RELEVANT
  NOT_RELEVANT
}

enum EvidenceStrength {
  STRONG
  MODERATE
  PARTIAL
  WEAK
  NOT_FOUND
  CONTRADICTORY
}

enum EvidenceConfidence {
  HIGH
  MEDIUM
  LOW
}

enum EvidenceType {
  DIRECT
  INFERRED
  MISSING
}

enum AssessmentStatus {
  STRONG_EVIDENCE
  REVIEW_REQUIRED
  MANDATORY_GAP
  INSUFFICIENT_EVIDENCE
}

enum CandidateDocumentStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED_RETRY
  FAILED_NEEDS_OCR
}

enum HrDecisionType {
  SHORTLIST
  HOLD
  REJECT
  INTERVIEW
}

enum AiTaskType {
  REQUIREMENT_INTERPRETATION
  WEIGHTING_RECOMMENDATION
  RESUME_INTELLIGENCE
  REQUIREMENT_EVIDENCE_ANALYSIS
  CAREER_CONSISTENCY_ANALYSIS
  CANDIDATE_COMPARISON
}

enum AiValidationStatus {
  VALID
  RETRIED_VALID
  FAILED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(HR_USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  createdProjects    RecruitmentProject[]      @relation("ProjectCreator")
  projectMemberships ProjectMember[]
  weightApprovals    RequirementWeightApproval[]
  requirementVersionsApproved JobRequirementVersion[]
  hrDecisions        HrDecision[]
  auditLogs          AuditLog[]
  resolvedMatchReviews CandidateMatchReview[]
}

model RecruitmentProject {
  id             String        @id @default(uuid())
  title          String
  department     String?
  businessUnit   String?
  location       String?
  hiringManager  String?
  vacancies      Int           @default(1)
  employmentType String?
  description    String?
  status         ProjectStatus @default(DRAFT)
  createdBy      String
  creator        User          @relation("ProjectCreator", fields: [createdBy], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  members        ProjectMember[]
  requirements   JobRequirement[]
  candidateLinks CandidateProjectLink[]
  comparisons    CandidateComparison[]
  uploadBatches  CandidateUploadBatch[]
  stagedUploads  StagedUpload[]
  matchReviews   CandidateMatchReview[]
}

// Project-level authorization spine (Phase 2, Section 1): the creator is
// auto-added as OWNER; HR_ADMIN/SYSTEM_ADMIN bypass this table entirely
// (see apps/api/src/modules/projects/authorization.ts) — it only governs
// which projects an ordinary HR_USER can reach.
model ProjectMember {
  id        String            @id @default(uuid())
  projectId String
  project   RecruitmentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  role      ProjectMemberRole @default(MEMBER)
  addedAt   DateTime          @default(now())

  @@unique([projectId, userId])
}

model JobRequirement {
  id                     String              @id @default(uuid())
  projectId              String
  project                RecruitmentProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category               RequirementCategory
  customCategoryLabel    String?             // set when category = OTHER; the extensibility point (Phase 2, Section 3)
  description            String
  mandatory              Boolean             @default(false)
  priority               RequirementPriority @default(MEDIUM)
  evidenceCriteria       String?             // free-text HR-entered criteria; structured AI criteria live in RequirementEvidenceCriterion
  hrNotes                String?
  aiInterpretationSummary String?
  aiInteractionId        String?
  aiSuggestedWeight      Decimal?            @db.Decimal(5, 2)
  hrApprovedWeight       Decimal?            @db.Decimal(5, 2)
  status                 RequirementStatus   @default(DRAFT)
  currentVersionNumber   Int                 @default(0) // 0 = never approved yet
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  semanticConcepts  RequirementSemanticConcept[]
  criteria          RequirementEvidenceCriterion[] @relation("RequirementCriteria")
  versions          JobRequirementVersion[]
  weightApprovals   RequirementWeightApproval[]
  evidence          Evidence[]
  assessments       Assessment[]
  batchVersionPins  CandidateBatchRequirementVersion[]
}

// AI-identified concepts semantically related to a requirement (Phase 2,
// Section 4) — e.g. "grievance handling" for "employee relations
// experience" — each carries its own relevance tier and a stated rationale,
// never a flat keyword list.
model RequirementSemanticConcept {
  id            String            @id @default(uuid())
  requirementId String
  requirement   JobRequirement    @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  concept       String
  relevance     SemanticRelevance
  rationale     String
  createdAt     DateTime          @default(now())
}

// Structured "what would convincing evidence look like" criteria (Phase 2,
// Section 5), AI-generated per requirement, distinct from the free-text
// JobRequirement.evidenceCriteria HR can type directly.
model RequirementEvidenceCriterion {
  id            String         @id @default(uuid())
  requirementId String
  requirement   JobRequirement @relation("RequirementCriteria", fields: [requirementId], references: [id], onDelete: Cascade)
  description   String
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
}

// Immutable snapshot taken at approval time (Phase 2, Section 10). Editing a
// JobRequirement after it has an approved version never overwrites this row
// — JobRequirement.status moves to CHANGED and a later re-approval creates
// versionNumber + 1. Assessment.requirementVersionId (added below) lets
// Phase 4 pin a candidate's analysis to the exact version used.
model JobRequirementVersion {
  id                  String              @id @default(uuid())
  requirementId       String
  requirement         JobRequirement      @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  versionNumber       Int
  category            RequirementCategory
  customCategoryLabel String?
  description         String
  mandatory           Boolean
  priority            RequirementPriority
  evidenceCriteriaSnapshot Json           // RequirementEvidenceCriterion[] at approval time
  aiInterpretationSummary  String?
  aiSuggestedWeight   Decimal?            @db.Decimal(5, 2)
  hrApprovedWeight    Decimal             @db.Decimal(5, 2)
  approvedBy          String
  approver            User                @relation(fields: [approvedBy], references: [id])
  approvedAt          DateTime            @default(now())

  assessments Assessment[]
  batchPins   CandidateBatchRequirementVersion[]

  @@unique([requirementId, versionNumber])
}

// One row per CV upload call (Phase 4 foundation, Decision 3). Its purpose
// is entirely to anchor CandidateBatchRequirementVersion below — pinning,
// once at upload time, which JobRequirementVersion every candidate in that
// batch is evaluated against, so a requirement edited mid-batch never
// causes candidate #1 and candidate #20 to be scored against different
// versions of the same requirement. This durably records that pin in the
// database (not just in worker memory) because batch documents are
// processed asynchronously, potentially far apart in time.
model CandidateUploadBatch {
  id        String             @id @default(uuid())
  projectId String
  project   RecruitmentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy String
  createdAt DateTime           @default(now())

  documents      CandidateDocument[]
  versionPins    CandidateBatchRequirementVersion[]
  stagedUploads  StagedUpload[]
}

// The pin itself: "in this batch, requirement X means version Y" — resolved
// once when the batch is created (see the upload route) from each
// requirement's latest APPROVED JobRequirementVersion at that moment, never
// re-queried per candidate during processing (Decision 3, points 1 and 4).
// Phase 4's evidence-analysis/assessment-writing code reads this table
// instead of asking "what's the current version" again.
model CandidateBatchRequirementVersion {
  id                   String                 @id @default(uuid())
  batchId              String
  batch                CandidateUploadBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  requirementId        String
  requirement          JobRequirement         @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  requirementVersionId String
  requirementVersion   JobRequirementVersion  @relation(fields: [requirementVersionId], references: [id], onDelete: Restrict)
  createdAt            DateTime               @default(now())

  @@unique([batchId, requirementId])
}

// History of every weight change, proposed or HR-modified — separate from
// JobRequirementVersion, which only snapshots the state AT approval.
model RequirementWeightApproval {
  id             String         @id @default(uuid())
  requirementId  String
  requirement    JobRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  approvedBy     String
  approver       User           @relation(fields: [approvedBy], references: [id])
  previousWeight Decimal?       @db.Decimal(5, 2)
  newWeight      Decimal        @db.Decimal(5, 2)
  hrNote         String?
  approvedAt     DateTime       @default(now())
}

model Candidate {
  id        String   @id @default(uuid())
  fullName  String
  email     String?
  phone     String?
  source    String?
  createdAt DateTime @default(now())
  // Set when the candidate's PII is anonymized under the retention policy
  // (Phase 2 hardening: "retained/anonymized historical representation").
  // The row itself is never hard-deleted once Evidence/Assessment/HrDecision
  // reference it — Evidence.candidate/Assessment.candidate/HrDecision.candidate
  // are onDelete: Restrict below, so the DB refuses a delete that would
  // orphan historical records. Purging PII means updating fullName/email/
  // phone in place and setting this timestamp, not deleting the row. The
  // actual purge job is Phase 7+ scope; this field only makes the model
  // ready for it.
  piiPurgedAt DateTime?

  // Phase 7 — Candidate Deduplication / Reuse. Deterministic identity
  // matching keys, distinct from the raw fullName/email/phone above:
  // email/phone hold the original extracted value (or remain unset, as
  // today); normalizedEmail/normalizedPhone are the exact, deterministic
  // lookup keys used only for duplicate matching (see
  // worker/src/identity-extraction.ts). Never unique — a collision must
  // route to CandidateMatchReview for HR resolution, never a DB error.
  // Excluded from matching entirely once piiPurgedAt is set (Phase 7A
  // Decision: PII purge itself remains out of scope, but a purged
  // candidate must never be silently reintroduced via a match).
  normalizedEmail String?
  normalizedPhone String?

  documents      CandidateDocument[]
  projectLinks   CandidateProjectLink[]
  experiences    CandidateExperience[]
  education      CandidateEducation[]
  skills         CandidateSkill[]
  certifications CandidateCertification[]
  languages      CandidateLanguage[]
  evidence             Evidence[]
  assessments          Assessment[]
  hrDecisions          HrDecision[]
  consistencyFindings  CandidateConsistencyFinding[]
  emailMatchReviews CandidateMatchReview[] @relation("MatchReviewEmailMatch")
  phoneMatchReviews CandidateMatchReview[] @relation("MatchReviewPhoneMatch")

  @@index([normalizedEmail])
  @@index([normalizedPhone])
}

// Per-project blind-screening label ("Candidate #007"); a candidate can be
// linked to many projects but each link gets its own anonymized label.
model CandidateProjectLink {
  id               String             @id @default(uuid())
  candidateId      String
  candidate        Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  projectId        String
  project          RecruitmentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  anonymizedLabel  String
  status           String             @default("ACTIVE")
  createdAt        DateTime           @default(now())

  @@unique([candidateId, projectId])
}

model CandidateDocument {
  id               String                   @id @default(uuid())
  candidateId      String
  candidate        Candidate                @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  projectId        String?
  fileType         String
  storageKey       String
  originalFilename String
  fileSizeBytes    Int?
  status           CandidateDocumentStatus  @default(QUEUED)
  failureReason    String?
  uploadedBy       String
  uploadedAt       DateTime                 @default(now())
  purgedAt         DateTime?
  // Full extracted text, preserved separately from the (purgeable) original
  // file so Phase 4 evidence extraction never has to re-parse the source
  // document — and so the original can be purged later under the retention
  // policy without losing what was extracted from it (architecture doc,
  // Section: Retention). extractedPageTexts is one string per PDF page for
  // page-level source references (Evidence.sourcePage); null for DOCX,
  // which has no fixed pagination.
  extractedText      String?
  extractedPageTexts Json?
  parsedAt           DateTime?
  batchId            String?
  // Atomic claim counter for ProcessingRun.attemptNumber (Phase 4A retry
  // design) — claimed via `UPDATE ... SET processingAttemptCounter =
  // processingAttemptCounter + 1 RETURNING ...`, never via a separate
  // SELECT MAX(attemptNumber)+1, so two concurrent processing attempts for
  // the same document can never claim the same attempt number (Postgres
  // serializes concurrent UPDATEs to the same row).
  processingAttemptCounter Int     @default(0)
  // The authoritative successful run for this document. Written ONLY when
  // a ProcessingRun reaches COMPLETED, in the same transaction as that
  // run's own completedAt write — never touched on FAILED or a stale
  // RUNNING run, so a failed/crashed run can never become current, and a
  // document with no successful run yet stays null (architecture doc,
  // Phase 4A retry design, Decision: no isCurrent on Assessment).
  currentProcessingRunId   String?
  currentProcessingRun     ProcessingRun? @relation("CurrentProcessingRun", fields: [currentProcessingRunId], references: [id], onDelete: SetNull)

  // Phase 7 — set only when this document was promoted from a StagedUpload
  // (deduplication review path) rather than created immediately at upload
  // time. @unique is the database-enforced half of the "one staged upload
  // -> at most one CandidateDocument" invariant (the atomic status-claim on
  // StagedUpload/CandidateMatchReview is the primary guard; this is the
  // backstop). storageKey above is, in that case, the literal same key the
  // StagedUpload was written to — never copied or moved.
  stagedUploadId String?      @unique
  stagedUpload   StagedUpload? @relation(fields: [stagedUploadId], references: [id], onDelete: SetNull)

  evidence            Evidence[]
  consistencyFindings CandidateConsistencyFinding[]
  batch               CandidateUploadBatch?         @relation(fields: [batchId], references: [id], onDelete: SetNull)
  processingRuns      ProcessingRun[]               @relation("DocumentProcessingRuns")
}

// Phase 7 — Candidate Deduplication / Reuse across Projects.
//
// Represents an uploaded file whose Candidate identity has not yet been
// resolved. Deliberately has NO candidateId: identity resolution happens
// BEFORE any Candidate-scoped row (CandidateDocument, ProcessingRun,
// Assessment, Evidence, CandidateConsistencyFinding) is ever created, so
// there is never a temporary/placeholder Candidate and never a need to
// re-key processing history onto a different candidate afterward.
//
// No raw or normalized email/phone is persisted here (data minimization,
// Phase 7A approved correction): identity extraction is recomputed
// transiently, in memory, from the immutable stored object at both (a) the
// initial match check during RESOLVING and (b) promotion time — never
// written to this row.
model StagedUpload {
  id               String                @id @default(uuid())

  projectId        String
  project          RecruitmentProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  batchId          String?
  batch            CandidateUploadBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  storageKey       String
  originalFilename String
  fileType         String
  fileSizeBytes    Int?

  uploadedBy       String
  uploadedAt       DateTime              @default(now())

  status           StagedUploadStatus    @default(PENDING_IDENTITY_RESOLUTION)
  failureReason    String?

  matchReview      CandidateMatchReview?
  promotedDocument CandidateDocument?
  createdAt        DateTime              @default(now())

  @@index([projectId, status])
}

enum StagedUploadStatus {
  PENDING_IDENTITY_RESOLUTION
  RESOLVING
  PENDING_REVIEW
  PROMOTED
  FAILED
}

// One row per StagedUpload that produced at least one deterministic
// identity match. Never deleted and never has its candidate reference(s)
// nulled after resolution — it remains a permanent, Restrict-protected
// historical record of what was flagged and what an administrator decided
// (Phase 7A: audit and Restrict-protection precedent, matching HrOverride).
//
// emailMatchedCandidateId/phoneMatchedCandidateId are two independent,
// nullable FKs rather than one — capped at 2 by the fixed two-signal
// design (email, phone; no others in Phase 7) — because a single FK cannot
// safely represent the case where email matches one existing Candidate and
// phone matches a DIFFERENT one (matchSignal = CONFLICT). No raw/normalized
// email or phone value is stored here — only the categorical matchSignal
// and the matched Candidate id(s) (Phase 7A approved minimization).
model CandidateMatchReview {
  id                      String                     @id @default(uuid())

  stagedUploadId          String                     @unique
  stagedUpload            StagedUpload               @relation(fields: [stagedUploadId], references: [id], onDelete: Cascade)

  projectId               String
  project                 RecruitmentProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  matchSignal             CandidateMatchSignal

  emailMatchedCandidateId String?
  emailMatchedCandidate   Candidate?                 @relation("MatchReviewEmailMatch", fields: [emailMatchedCandidateId], references: [id], onDelete: Restrict)

  phoneMatchedCandidateId String?
  phoneMatchedCandidate   Candidate?                 @relation("MatchReviewPhoneMatch", fields: [phoneMatchedCandidateId], references: [id], onDelete: Restrict)

  // Doubles as the resolution outcome: PENDING -> LINK_EXISTING or
  // PENDING -> CREATE_NEW, exactly once (enforced by an atomic compare-
  // and-set on this field, never a second write path).
  status                  CandidateMatchReviewStatus @default(PENDING)
  resolvedBy              String?
  resolver                User?                      @relation(fields: [resolvedBy], references: [id])
  resolvedAt              DateTime?

  createdAt               DateTime                   @default(now())

  @@index([projectId, status])
}

enum CandidateMatchReviewStatus {
  PENDING
  LINK_EXISTING
  CREATE_NEW
}

// EMAIL/PHONE: exactly one signal matched, to one Candidate. BOTH: both
// signals matched the SAME Candidate (stronger corroboration, still not
// automatic). CONFLICT: the two signals matched two DIFFERENT Candidates —
// neither is auto-selected; the administrator must choose, and the
// identity-enrichment rules (worker/src/identity-resolution.ts) forbid
// writing either field onto either candidate in this case.
enum CandidateMatchSignal {
  EMAIL
  PHONE
  BOTH
  CONFLICT
}

enum ProcessingRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

// One row per execution of the whole CandidateDocument processing pipeline
// (parse -> Resume Intelligence -> Requirement Evidence Analysis) — Phase
// 4A retry design. Never deleted, never updated once terminal (COMPLETED
// or FAILED); a retry creates a NEW row rather than touching this one, so
// every historical attempt stays fully intact and queryable. Assessment
// rows reference the run that produced them
// (Assessment.processingRunId) — never deleted or mutated by a later run.
model ProcessingRun {
  id                  String              @id @default(uuid())
  candidateDocumentId String
  candidateDocument   CandidateDocument   @relation("DocumentProcessingRuns", fields: [candidateDocumentId], references: [id], onDelete: Restrict)
  attemptNumber       Int
  status              ProcessingRunStatus @default(RUNNING)
  startedAt           DateTime            @default(now())
  completedAt         DateTime?
  createdAt           DateTime            @default(now())

  assessments         Assessment[]
  consistencyFindings CandidateConsistencyFinding[]
  currentForDocuments CandidateDocument[] @relation("CurrentProcessingRun")

  @@unique([candidateDocumentId, attemptNumber])
}

model CandidateExperience {
  id                  String    @id @default(uuid())
  candidateId         String
  candidate           Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  documentId          String?
  employer            String
  title               String
  startDate           DateTime?
  endDate             DateTime?
  isCurrent           Boolean   @default(false)
  responsibilities    String[]
  functionalAreaTags  String[]
  extractedConfidence EvidenceConfidence?
  createdAt           DateTime  @default(now())
}

model CandidateEducation {
  id          String    @id @default(uuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  institution String
  degree      String?
  field       String?
  startDate   DateTime?
  endDate     DateTime?
}

model CandidateSkill {
  id          String    @id @default(uuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skillName   String
  category    String?
}

model CandidateCertification {
  id           String    @id @default(uuid())
  candidateId  String
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  name         String
  issuer       String?
  dateObtained DateTime?
}

model CandidateLanguage {
  id          String    @id @default(uuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  language    String
  proficiency String?
}

// The traceability spine: Requirement -> Evidence -> Assessment. Evidence
// rows are never deleted by a candidate-profile removal (onDelete: Restrict
// below) — a candidate with any Evidence must be anonymized in place, never
// hard-deleted (see Candidate.piiPurgedAt). Same protection applies to the
// requirement side (Phase 4 foundation, Decision 4): no route deletes a
// JobRequirement today (the "delete" endpoint only archives it), but once
// Phase 4 starts writing real Evidence/Assessment history, a requirement
// must never be hard-deletable out from under it either.
model Evidence {
  id               String              @id @default(uuid())
  requirementId    String
  requirement      JobRequirement      @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  candidateId      String
  candidate        Candidate           @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  projectId        String
  sourceDocumentId String?
  // The original CV is the shortest-lived record under the retention model
  // (Section: Security — Retention) and may be purged while the Evidence
  // row — which already carries its own extracted evidenceText/sourcePage —
  // survives; SetNull lets that purge happen without touching Evidence.
  sourceDocument   CandidateDocument?  @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  sourcePage       Int?
  evidenceText     String?
  evidenceType     EvidenceType
  evidenceStrength EvidenceStrength
  confidence       EvidenceConfidence
  aiModel          String?
  aiPromptVersion  String?
  aiInteractionId  String?
  createdAt        DateTime            @default(now())

  assessmentLinks AssessmentEvidence[]
}

// One row per candidate x requirement; the AI assessment is immutable once
// written — HR reactions are separate HrDecision/HrOverride rows. Never
// deleted by a candidate-profile removal (onDelete: Restrict) for the same
// reason as Evidence.
// Immutable once written (Phase 1 design, reaffirmed in the Phase 4A retry
// review): never updated, never deleted by a retry. A retry creates a new
// ProcessingRun with its own new Assessment rows instead — the old ones
// stay exactly as they were written, forever. processingRunId + the
// [processingRunId, requirementId] unique constraint below is what makes a
// single run's Assessment set well-defined and duplicate-proof; which run
// is "current" for a document lives on CandidateDocument.currentProcessingRunId,
// never as a field on Assessment itself.
model Assessment {
  id                     String            @id @default(uuid())
  candidateId            String
  candidate              Candidate         @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  projectId              String
  requirementId          String
  requirement            JobRequirement    @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  // Pins the assessment to the exact approved requirement version it was
  // scored against (Phase 2, Section 10) — nullable because Phase 1 predates
  // versioning; Phase 4's assessment-writing code should always set this.
  requirementVersionId   String?
  requirementVersion     JobRequirementVersion? @relation(fields: [requirementVersionId], references: [id])
  processingRunId        String
  processingRun          ProcessingRun     @relation(fields: [processingRunId], references: [id], onDelete: Restrict)
  aiAssessmentSummary    String
  status                 AssessmentStatus
  // Deliberately left null in Phase 4A — no approved deterministic scoring
  // formula exists yet (the formula previously drafted here was explicitly
  // rejected). Populate only once a formula is approved; do not infer one.
  computedScoreContribution Decimal?       @db.Decimal(6, 4)
  aiInteractionId        String?
  createdAt              DateTime          @default(now())

  overrides    HrOverride[]
  evidenceLinks AssessmentEvidence[]

  @@index([candidateId, projectId])
  @@unique([processingRunId, requirementId])
}

// Explicit traceability between an Assessment and the Evidence rows behind
// it (Phase 2 hardening, Section 1) — deliberately NOT inferred from
// matching candidateId+projectId+requirementId, because that can't
// distinguish evidence that was actually used from evidence that existed
// for the same requirement but was judged weaker/irrelevant, and can't
// order multiple supporting quotes. SUPPORTING rows are what the assessment
// summary is built from; CONSIDERED_REJECTED rows record evidence the AI
// looked at for this requirement but did not rely on (e.g. a weaker or
// contradictory quote) — both are audit-visible, matching the evidence-first
// philosophy that missing/rejected evidence is as answerable as used
// evidence (master instruction Section 51: "What is missing?").
model AssessmentEvidence {
  id           String                  @id @default(uuid())
  assessmentId String
  assessment   Assessment              @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  evidenceId   String
  evidence     Evidence                @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  role         AssessmentEvidenceRole
  rationale    String? // why this evidence was used or set aside for this assessment
  createdAt    DateTime                @default(now())

  @@unique([assessmentId, evidenceId])
}

enum AssessmentEvidenceRole {
  SUPPORTING
  CONSIDERED_REJECTED
}

// Categories for Career/Consistency Analysis findings (architecture doc
// master instruction Section 16: employment gaps, overlapping dates,
// unclear chronology, responsibilities inconsistent with stated seniority,
// and general "something here needs a human look" cases not covered by a
// more specific category).
enum ConsistencyFindingType {
  EMPLOYMENT_GAP
  OVERLAPPING_DATES
  UNCLEAR_CHRONOLOGY
  RESPONSIBILITY_SENIORITY_MISMATCH
  POTENTIAL_INCONSISTENCY
  OTHER
}

// Neutral-language severity only (master instruction Section 16: "Avoid
// unsupported conclusions about candidate integrity, honesty, reliability
// or character") — never a judgment stronger than "needs a look."
enum ConsistencyFindingSeverity {
  INFORMATION_UNCLEAR
  VERIFICATION_REQUIRED
  POTENTIAL_INCONSISTENCY
}

// Career-Consistency Analysis findings (Phase 4 foundation, Decision 2) —
// deliberately a separate model from Evidence/AssessmentEvidence: a career
// gap or chronology issue is a fact about the candidate's own timeline, not
// evidence for or against a specific job requirement, and conflating the
// two would misuse the Requirement Evidence traceability chain for
// something it wasn't built to represent. Every finding still carries its
// own traceability back to a source document/page/quote whenever it is
// based on documentary evidence (sourceDocumentId/sourcePage/evidenceText
// nullable together only for a finding inferred purely from date math
// across CandidateExperience rows, e.g. a gap between two employers' dates,
// which has no single quote to cite).
//
// candidateId (Restrict, matching Evidence/Assessment — a candidate with
// findings can't be hard-deleted) + projectId (plain scalar, matching how
// Evidence.projectId is *not* backed by an explicit RecruitmentProject
// relation either) is used instead of the field list's suggested
// `assessmentId`: Assessment is strictly per-requirement in this schema
// (Assessment.requirementId is required, non-nullable), and a consistency
// finding about a candidate's overall career timeline isn't "for" any one
// requirement, so pinning it to one arbitrary Assessment row would be
// semantically wrong. projectId is the scoping field Evidence already
// establishes as this schema's convention for "which project was this
// produced for."
model CandidateConsistencyFinding {
  id               String                      @id @default(uuid())
  candidateId      String
  candidate        Candidate                   @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  projectId        String
  findingType      ConsistencyFindingType
  severity         ConsistencyFindingSeverity
  description      String
  sourceDocumentId String?
  sourceDocument   CandidateDocument?          @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  sourcePage       Int?
  evidenceText     String?
  confidence       EvidenceConfidence
  aiInteractionId  String?
  // Completes the ProcessingRun traceability model (Phase 5A follow-up):
  // Assessment already carries this; CandidateConsistencyFinding was the
  // one sibling model produced by the same per-document pipeline run left
  // without it. Lets a reader distinguish findings from a run that later
  // failed/was retried from the candidate's current, authoritative run —
  // never deleted or reassigned by a retry (a retry creates new findings
  // under its own new run; historical findings and their processingRunId
  // stay exactly as written).
  processingRunId  String
  processingRun    ProcessingRun               @relation(fields: [processingRunId], references: [id], onDelete: Restrict)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@index([candidateId, projectId])
}

model CandidateComparison {
  id          String             @id @default(uuid())
  projectId   String
  project     RecruitmentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  candidateIds String[]
  createdBy   String
  summaryJson Json
  createdAt   DateTime           @default(now())
}

// A decision is itself a historical record (master instruction Section 51:
// "What did HR decide?") — candidate is now an explicit, enforced relation
// (previously a bare unindexed string) so it gets the same Restrict
// protection as Evidence/Assessment rather than silently going orphaned.
model HrDecision {
  id          String         @id @default(uuid())
  candidateId String
  candidate   Candidate      @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  projectId   String
  decision    HrDecisionType
  decidedBy   String
  decider     User           @relation(fields: [decidedBy], references: [id])
  notes       String?
  decidedAt   DateTime       @default(now())

  override HrOverride?
}

// Links a decision back to the untouched original AI assessment — never
// mutates Assessment; overridden=false just records that HR agreed with AI.
model HrOverride {
  id              String     @id @default(uuid())
  decisionId      String     @unique
  decision        HrDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  assessmentId    String
  assessment      Assessment @relation(fields: [assessmentId], references: [id])
  overridden      Boolean
  hrNote          String?
  createdAt       DateTime   @default(now())
}

// Every AI Gateway call, regardless of provider, for audit + debugging.
model AiInteraction {
  id               String             @id @default(uuid())
  taskType         AiTaskType
  provider         String
  model            String
  promptVersion    String
  inputRef         String?
  outputJson       Json?
  validationStatus AiValidationStatus
  latencyMs        Int?
  createdAt        DateTime           @default(now())
}

// System/admin-only — never exposed to ordinary HR users (Section 43).
model AiModelConfiguration {
  id            String     @id @default(uuid())
  taskType      AiTaskType @unique
  provider      String
  model         String
  temperature   Decimal?   @db.Decimal(3, 2)
  maxTokens     Int?
  timeoutMs     Int?
  retryPolicy   Json?
  promptVersion String
  isActive      Boolean    @default(true)
  updatedAt     DateTime   @updatedAt
}

// Append-only at the application layer (DB role has INSERT only in prod).
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}
